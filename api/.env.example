# MongoDB connection string
MONGO_URL=mongodb+srv://user:password@cluster.mongodb.net/?appName=Cluster0

# JWT — generate a strong random secret: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me-use-a-long-random-string-in-production

# Token lifetimes (seconds). Defaults: 900 (15 min access), 604800 (7 days refresh)
ACCESS_TOKEN_EXPIRE_SECONDS=900
REFRESH_TOKEN_EXPIRE_SECONDS=604800

# Python settings
PYTHONUNBUFFERED=true

# Set to "true" to run without a real MongoDB (uses in-memory mock — dev/test only)
USE_MOCK=false
